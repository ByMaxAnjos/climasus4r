%%{init: {'theme':'base', 'themeVariables': {'fontFamily':'Inter, Arial, sans-serif','fontSize':'14px','primaryTextColor':'#1B1B1B','lineColor':'#3E7C59'}}}%%
flowchart TB
    H["Health event or time series<br/>date t + location"]:::input
    Q{"Exposure-lag<br/>hypothesis"}:::decision
    H --> Q

    Q --> AC["Acute and short-delay effects"]:::groupTitle
    Q --> DL["Delayed and distributed mechanisms"]:::groupTitle
    Q --> EX["Extremes and ecological exposure"]:::groupTitle

    subgraph G1[" "]
        direction TB
        A1["same-day effect"] --> S1["exact<br/>climate(t)"]
        A2["known fixed delay"] --> S2["discrete_lag<br/>climate(t - L)"]
        A3["recent accumulation"] --> S3["moving_window<br/>mean/sum (t - W, t)"]
    end

    subgraph G2[" "]
        direction TB
        B1["incubation window"] --> S4["offset_window<br/>(t - W2, t - W1)"]
        B2["unknown lag shape"] --> S5["distributed_lag<br/>matrix 0...L for crossbasis()"]
        B3["biological decay"] --> S6["weighted_window<br/>decay-weighted mean"]
    end

    subgraph G3[" "]
        direction TB
        C1["heat extremes"] --> S7["threshold_exceedance<br/>days above percentile"]
        C2["cold extremes"] --> S8["cold_wave_exceedance<br/>days below percentile"]
        C3["vector/pathogen development"] --> S9["degree_days<br/>units above base temperature"]
        C4["seasonal signal"] --> S10["seasonal<br/>DJF · MAM · JJA · SON"]
    end

    AC --> G1
    DL --> G2
    EX --> G3

    G1 --> OUT["climasus_df output<br/>stage = climate<br/>strategy recorded in metadata"]:::output
    G2 --> OUT
    G3 --> OUT

    classDef input fill:#EAF3FF,stroke:#3167A8,stroke-width:1.3px;
    classDef decision fill:#FFF7E8,stroke:#D97C1D,stroke-width:1.5px;
    classDef output fill:#EEF8EF,stroke:#2F7D4B,stroke-width:1.5px;
    classDef groupTitle fill:#FFF7E8,stroke:#D97C1D,stroke-width:1.4px,font-weight:bold;
    classDef group fill:#FFF8ED,stroke:#D97C1D,stroke-width:1.1px;
    classDef mech fill:#FFF7E8,stroke:#E5BF7B,stroke-width:1px;
    classDef strat fill:#FFFFFF,stroke:#D97C1D,stroke-width:1.2px;
    class G1,G2,G3 group;
    class A1,A2,A3,B1,B2,B3,C1,C2,C3,C4 mech;
    class S1,S2,S3,S4,S5,S6,S7,S8,S9,S10 strat;
