flowchart LR

    subgraph PREP["1. Data preparation"]
        direction TB
        A1["Health data acquisition<br/>SIM · SIH · SIA · SINAN · CNES · SINASC"]
        A1R["Implementation<br/>sus_data_import()"]:::func

        A2["Data harmonisation<br/>encoding, nomenclature and administrative codes"]
        A2R["Implementation<br/>sus_data_clean_encoding()<br/>sus_data_standardize()"]:::func

        A3["Case definition<br/>ICD-10 outcomes and demographic strata"]
        A3R["Implementation<br/>sus_data_filter_cid()<br/>sus_data_filter_demographics()"]:::func

        A4["Outcome construction<br/>derived variables and aggregated health time series"]
        A4R["Implementation<br/>sus_data_create_variables()<br/>sus_data_aggregate()"]:::func

        A1 --> A2 --> A3 --> A4
        A1 -.-> A1R
        A2 -.-> A2R
        A3 -.-> A3R
        A4 -.-> A4R
    end

    subgraph INT["2. Exposure and covariate integration"]
        direction TB
        B1["Spatial linkage<br/>municipalities, health records and monitoring stations"]
        B1R["Implementation<br/>sus_spatial_join()"]:::func

        B2["Socioeconomic context<br/>IBGE census-derived indicators"]
        B2R["Implementation<br/>sus_census_join()"]:::func

        B3["Observed climate<br/>INMET station records and imputation"]
        B3R["Implementation<br/>sus_climate_inmet()<br/>sus_climate_fill_inmet()"]:::func

        B4["Gridded environmental exposures<br/>ERA5 · CHIRPS · air pollution · land cover"]
        B4R["Implementation<br/>sus_grid_era5()<br/>sus_grid_chirps()<br/>sus_grid_pollution_cams()<br/>sus_grid_join()"]:::func

        B5["Temporal alignment<br/>lagged exposure histories and analytical windows"]
        B5R["Implementation<br/>sus_climate_aggregate()"]:::func

        B1 --> B2
        B1 --> B3 --> B5
        B4 --> B5
        B1 -.-> B1R
        B2 -.-> B2R
        B3 -.-> B3R
        B4 -.-> B4R
        B5 -.-> B5R
    end

    subgraph ANA["3. Epidemiological analysis and modelling"]
        direction TB
        C1["Exposure-response estimation<br/>distributed lag non-linear models"]
        C1R["Implementation<br/>sus_mod_dlnm()"]:::func

        C2["Quasi-experimental designs<br/>case-crossover and interrupted time-series analyses"]
        C2R["Implementation<br/>sus_mod_casecrossover()<br/>sus_mod_its()"]:::func

        C3["Health impact assessment<br/>attributable fractions, burden and excess events"]
        C3R["Implementation<br/>sus_mod_af()<br/>sus_mod_burden()<br/>sus_mod_excess()"]:::func

        C4["Evidence synthesis<br/>multi-city pooled estimates"]
        C4R["Implementation<br/>sus_mod_pool()"]:::func

        C5["Spatial inference<br/>autocorrelation, clusters, Bayesian risk and vulnerability"]
        C5R["Implementation<br/>sus_mod_spatial_moran()<br/>sus_mod_spatial_scan()<br/>sus_mod_spatial_bayes()<br/>sus_mod_vulnerability_index()"]:::func

        C1 --> C3
        C1 --> C4
        C2 --> C3
        C5 --> C3
        C1 -.-> C1R
        C2 -.-> C2R
        C3 -.-> C3R
        C4 -.-> C4R
        C5 -.-> C5R
    end

    subgraph RAP["4. Reproducible analytical pipeline"]
        direction TB
        D1["Workflow orchestration<br/>declarative pipeline specification"]
        D1R["Implementation<br/>sus_rap_recipe()<br/>sus_rap_targets()"]:::func

        D2["Versioned outputs<br/>data products, model objects, figures and provenance records"]
        D2R["Implementation<br/>sus_rap_export()"]:::func

        D1 --> D2
        D1 -.-> D1R
        D2 -.-> D2R
    end

    subgraph VIZ["5. Diagnostics and visualisation"]
        direction TB
        E1["Health-series diagnostics<br/>time series, maps and demographic profiles"]
        E1R["Implementation<br/>sus_data_plot_aggregate_ts()<br/>sus_data_plot_aggregate_map()<br/>sus_data_plot_demographics()"]:::func

        E2["Climate diagnostics<br/>gap filling, aggregation, heat-wave and cold-wave summaries"]
        E2R["Implementation<br/>sus_climate_plot_fill()<br/>sus_climate_plot_aggregate()<br/>sus_climate_plot_heatwaves()<br/>sus_climate_plot_coldwaves()<br/>sus_grid_plot()"]:::func

        E3["Model diagnostics<br/>exposure-response curves, pooled estimates and sensitivity checks"]
        E3R["Implementation<br/>sus_mod_plot_dlnm()<br/>sus_mod_plot_pool()<br/>sus_mod_plot_sensitivity()<br/>sus_mod_plot_swot()"]:::func

        E4["Impact and spatial-risk diagnostics<br/>burden, attributable fraction, Bayesian and cluster maps"]
        E4R["Implementation<br/>sus_mod_plot_af()<br/>sus_mod_plot_burden()<br/>sus_mod_plot_ml()<br/>sus_mod_plot_spacetime()<br/>sus_mod_plot_spatial_bayes()<br/>sus_mod_plot_spatial_moran()<br/>sus_mod_plot_spatial_scan()<br/>sus_mod_plot_vulnerability()"]:::func

        E1 --> E2 --> E3 --> E4
        E1 -.-> E1R
        E2 -.-> E2R
        E3 -.-> E3R
        E4 -.-> E4R
    end

