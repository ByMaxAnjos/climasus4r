  'fontFamily':'Arial, Helvetica, sans-serif',
  'fontSize':'17px',
  'primaryTextColor':'#111111',
  'lineColor':'#4A4A4A',
  'primaryColor':'#F7F7F7',
  'clusterBkg':'#FFFFFF',
  'clusterBorder':'#6B6B6B'
}}}%%

flowchart LR

    subgraph PREP["1. Data preparation"]
        direction TB
        A1["Health data acquisition<br/>SIM · SIH · SIA · SINAN · CNES · SINASC<br/>R: sus_data_import()"]
        A2["Data harmonisation<br/>encoding, nomenclature and administrative codes<br/>R: sus_data_clean_encoding(); sus_data_standardize()"]
        A3["Case definition<br/>ICD-10 outcomes and demographic strata<br/>R: sus_data_filter_cid(); sus_data_filter_demographics()"]
        A3D["Diagnostic<br/>sus_data_plot_demographics()"]:::diag
        A4["Outcome construction<br/>derived variables and aggregated health time series<br/>R: sus_data_create_variables(); sus_data_aggregate()"]
        A4D["Diagnostic<br/>sus_data_plot_aggregate_ts(); sus_data_plot_aggregate_map()"]:::diag

        A1 --> A2 --> A3 --> A4
        A3 -.-> A3D
        A4 -.-> A4D
    end

    subgraph INT["2. Exposure and covariate integration"]
        direction TB
        B1["Spatial linkage<br/>municipalities, health records and monitoring stations<br/>R: sus_spatial_join()"]
        B2["Socioeconomic context<br/>IBGE census-derived indicators<br/>R: sus_census_join()"]
        B3["Observed climate<br/>INMET station records and imputation<br/>R: sus_climate_inmet(); sus_climate_fill_inmet()"]
        B3D["Diagnostic<br/>sus_climate_plot_fill(); sus_climate_plot_heatwaves(); sus_climate_plot_coldwaves()"]:::diag
        B4["Gridded environmental exposures<br/>ERA5 · CHIRPS · air pollution · land cover<br/>R: sus_grid_era5(); sus_grid_chirps(); sus_grid_pollution_cams(); sus_grid_join()"]
        B4D["Diagnostic<br/>sus_grid_plot()"]:::diag
        B5["Temporal alignment<br/>lagged exposure histories and analytical windows<br/>R: sus_climate_aggregate()"]
        B5D["Diagnostic<br/>sus_climate_plot_aggregate()"]:::diag

        B1 --> B2
        B1 --> B3
        B3 --> B5
        B4 --> B5
        B3 -.-> B3D
        B4 -.-> B4D
        B5 -.-> B5D
    end

    subgraph ANA["3. Epidemiological analysis and modelling"]
        direction TB
        C1["Exposure-response estimation<br/>distributed lag non-linear models<br/>R: sus_mod_dlnm()"]
        C1D["Diagnostic<br/>sus_mod_plot_dlnm()"]:::diag
        C2["Quasi-experimental designs<br/>case-crossover and interrupted time-series analyses<br/>R: sus_mod_casecrossover(); sus_mod_its()"]
        C3["Health impact assessment<br/>attributable fractions, burden and excess events<br/>R: sus_mod_af(); sus_mod_burden(); sus_mod_excess()"]
        C3D["Diagnostic<br/>sus_mod_plot_af(); sus_mod_plot_burden()"]:::diag
        C4["Evidence synthesis<br/>multi-city pooled estimates<br/>R: sus_mod_pool()"]
        C4D["Diagnostic<br/>sus_mod_plot_pool(); sus_mod_plot_sensitivity()"]:::diag
        C5["Spatial inference<br/>autocorrelation, clusters, Bayesian risk and vulnerability<br/>R: sus_mod_spatial_moran(); sus_mod_spatial_scan(); sus_mod_spatial_bayes(); sus_mod_vulnerability_index()"]
        C5D["Diagnostic<br/>sus_mod_plot_spatial_moran(); sus_mod_plot_spatial_scan(); sus_mod_plot_spatial_bayes(); sus_mod_plot_vulnerability()"]:::diag

        C1 --> C3
        C1 --> C4
        C2 --> C3
        C5 --> C3
        C1 -.-> C1D
        C3 -.-> C3D
        C4 -.-> C4D
        C5 -.-> C5D
    end

    META["Structured provenance<br/>source · processing stage · analytical history<br/>R: sus_meta()"]:::meta

    subgraph RAP["Optional: reproducible analytical pipeline"]
        direction LR
        D1["Workflow orchestration<br/>declarative pipeline specification<br/>R: sus_rap_recipe(); sus_rap_targets()"]
        D2["Versioned outputs<br/>data products, model objects, figures and provenance records<br/>R: sus_rap_export()"]
        D1 --> D2
    end

    A4 --> B1
    B5 --> C1
    B5 --> C2
    B5 --> C5

    PREP -.-> META
    META -.-> PREP
    INT -.-> META
    META -.-> INT
    ANA -.-> META
    META -.-> ANA
    META -.-> RAP

    classDef stage fill:#FFFFFF,stroke:#4A4A4A,stroke-width:1.2px,color:#111111;
    classDef diag fill:#FAFAFA,stroke:#B0B0B0,stroke-width:0.8px,stroke-dasharray:3 2,color:#4A4A4A;
    classDef meta fill:#F1F5F9,stroke:#3B5875,stroke-width:1.2px,color:#111111;
    classDef optional fill:#FFFFFF,stroke:#6B6B6B,stroke-width:1px,stroke-dasharray:5 3,color:#111111;

    class PREP,INT,ANA stage;
    class RAP optional;
